<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>wavemaker_web</name>
  <version>0.0.0</version>
  <description>Web page for running a wavemaker through wavemaker_bridge, in place of LabVIEW.</description>
  <maintainer email="vebjorn.steinsholt@ntnu.no">vebjorn-steinsholt</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>wavemaker_interfaces</exec_depend>
  <exec_depend>wavemaker_controller</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
