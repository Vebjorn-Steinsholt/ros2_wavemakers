# Goal
# Used when wavemaker_mode_pregenerated is false.
# Wave height H (crest to trough) in meters and wave period in seconds.
float64 height
float64 period
# Absolute wavemaker positions in meters, sampled at this fixed interval.
# Used when wavemaker_mode_pregenerated is true.
float64[] positions
float64 sample_interval
---
# Result
bool success
string message
---
# Feedback
float64 desired_position
float64 actual_position
float64 elapsed_time
